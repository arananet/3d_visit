# Barcelona Virtual Tour — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to the repository.

# Google Maps Platform API key
# Enable: Map Tiles API (Photorealistic 3D Tiles)
# Restrict to: your Railway domain + HTTP referrers
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Aerial View API key
# Enable: Aerial View API
# May be the same key as GOOGLE_MAPS_API_KEY if both APIs are enabled on one key
GOOGLE_AERIAL_VIEW_API_KEY=your_google_aerial_view_api_key_here

# World Labs API key
# Obtain from: https://platform.worldlabs.ai/api-keys
WORLDLABS_API_KEY=your_worldlabs_api_key_here

# Server port (Railway sets this automatically)
PORT=3000

# Node environment
NODE_ENV=production
